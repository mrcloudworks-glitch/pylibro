# Copy this file to pylibro.env and fill in your own values.
# pylibro.env is gitignored; this example file is the committed reference.
PYLIBRO_KINDLE_EMAIL=your-device@kindle.com
PYLIBRO_KINDLE_SMTP_HOST=smtp.gmail.com
PYLIBRO_KINDLE_SMTP_PORT=587
PYLIBRO_KINDLE_SMTP_USER=your-sender@gmail.com
PYLIBRO_KINDLE_SMTP_PASSWORD=your-google-app-password
